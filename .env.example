PORT=7344
MONGODB_CONNECT="mongodb://127.0.0.1:27017/canis_world"
# Linux Server 預設使用 host network 與上面的 127.0.0.1，不需設定以下兩項。
# Docker Desktop 本機才取消註解 network 設定，並改用 host.docker.internal：
# BACKEND_NETWORK_MODE=bridge
# MONGODB_CONNECT="mongodb://host.docker.internal:27017/canis_world"
PASSWORD_HASH="CanisDen"
CORS_ORIGINS=http://localhost:7342,http://localhost:7343,https://canis.world,https://link.canis.world,https://dashboard.canis.world
# 只有網域不同時才修改 CORS_ORIGINS。
ALLOW_REGISTRATION=false
RESEND_API_KEY=
CONTACT_FROM_EMAIL="Canis Den <contact@canis.world>"
CONTACT_TO_EMAIL=admin@canis.world

# 前台：http://localhost:7342
# 後台：http://localhost:7343
# API：http://localhost:7344
